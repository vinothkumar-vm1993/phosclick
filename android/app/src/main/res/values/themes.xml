<resources>
    <style name="Theme.PhosClick" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="colorPrimary">?attr/colorOnSurface</item>
        <item name="colorOnPrimary">#101318</item>
        <item name="colorPrimaryContainer">#30363E</item>
        <item name="colorOnPrimaryContainer">?attr/colorOnSurface</item>
        <item name="colorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="colorOnSecondary">#19212C</item>
        <item name="colorSecondaryContainer">#30363E</item>
        <item name="colorOnSecondaryContainer">?attr/colorOnSurface</item>
        <item name="colorTertiary">?attr/colorOnSurfaceVariant</item>
        <item name="colorOnTertiary">#101318</item>
        <item name="colorTertiaryContainer">#30363E</item>
        <item name="colorOnTertiaryContainer">?attr/colorOnSurface</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceContainerHigh">#000000</item>
        <item name="colorSurfaceContainer">#000000</item>
        <item name="colorSurfaceContainerLow">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorOnSurface">#F0F3F7</item>
        <item name="colorOnSurfaceVariant">#C0C7D2</item>
        <item name="colorOutline">#424A56</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PhosClick.Dialog</item>
    </style>
    <style name="ThemeOverlay.PhosClick.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.PhosClick.Dialog</item>
        <item name="colorPrimary">?attr/colorOnSurface</item>
        <item name="colorSecondary">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="ShapeAppearanceOverlay.PhosClick.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <color name="launcher_background">#101214</color>
</resources>
